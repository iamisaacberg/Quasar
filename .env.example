# Copy to .env. Quasar reads KEY=VALUE lines; environment variables take precedence.
# This token is intentionally sent to the browser. Use ONLY a public pk. token.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
# Do not put Google credentials in this file. Authenticate bq separately using Google CLI.
# After importing WeatherNext, set the snapshot path below:
QUASAR_WEATHERNEXT_FILE=

# Explicit parcel assessments produced by a separately documented method on LinuxONE.
# Requires matching QUASAR_PARCEL_DATABASE and existing parcel API authentication.
# No artifact means transparent/unknown parcels; geometry never supplies a score.
# QUASAR_EXPOSURE_FILE=data/processed/okaloosa/exposure.json

# Shadcnblocks registry access for UI development only. Never expose in browser code.
SHADCNBLOCKS_API_KEY=

# Optional for npm run dev:wifi only. Otherwise it prompts in the terminal.
# Use a unique shared password of at least 12 characters; never commit its value.
# QUASAR_WIFI_PASSWORD=

# The hosted application is public; no team password is required.

# Optional private IBM LinuxONE <-> Vercel snapshot bridge.
# On LinuxONE only: enable the read-only endpoint and set a random 32+ character token.
# QUASAR_DATA_BRIDGE_SERVE=1
# QUASAR_DATA_BRIDGE_TOKEN=
# On Vercel only: point to the public HTTPS reverse proxy, not the SSH endpoint.
# QUASAR_DATA_BRIDGE_URL=https://your-host.example/bridge/v1
# Set the same token as a server-only Vercel runtime secret. Never use VITE_.
# QUASAR_DATA_BRIDGE_TOKEN=

# Optional local Isaias archive and curated exercise network (no cloud access at runtime).
QUASAR_REPLAY_FILE=data/processed/isaias-2026.json
QUASAR_ROUTES_FILE=data/processed/evacuation-network.json

# Optional verified descriptive-input inspection artifact (directory with manifest.json).
# Built locally with scripts/prepare_parcel_inspection.py; never triggers cloud queries.
# Configure on the inventory-serving host; Vercel uses its existing server-only proxy.
# QUASAR_PARCEL_CONTEXT_DIRECTORY=data/processed/okaloosa/parcel-inspection/RUN
