# Copy to .env. Quasar reads KEY=VALUE lines; environment variables take precedence.
# This token is intentionally sent to the browser. Use ONLY a public pk. token.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_STYLE=mapbox://styles/mapbox/satellite-streets-v12
# Do not put Google credentials in this file. Authenticate bq separately using Google CLI.
# After importing WeatherNext, set the snapshot path below:
QUASAR_WEATHERNEXT_FILE=

# Shadcnblocks registry access for UI development only. Never expose in browser code.
SHADCNBLOCKS_API_KEY=

# Optional for npm run dev:wifi only. Otherwise it prompts in the terminal.
# Use a unique shared password of at least 12 characters; never commit its value.
# QUASAR_WIFI_PASSWORD=

# Vercel runtime secret. Hosted routes refuse all access if missing or invalid.
# Set separately in Vercel Preview and Production; never expose through VITE_.
# QUASAR_TEAM_PASSWORD=

# Optional local Isaias archive and curated exercise network (no cloud access at runtime).
QUASAR_REPLAY_FILE=data/processed/isaias-2026.json
QUASAR_ROUTES_FILE=data/processed/evacuation-network.json
